# Optional free analytics providers
# Create a Google Analytics 4 Web stream and paste the Measurement ID, e.g. G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=

# Create a Microsoft Clarity project and paste the Project ID
VITE_CLARITY_PROJECT_ID=

# Server-only checklist capture values.
# Do not prefix these with VITE_ and do not expose them in browser code.
EMAIL_PROVIDER=mailerlite
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=

# Optional fallback if switching back to beehiiv.
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=
